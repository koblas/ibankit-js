{
  "name": "ibankit",
  "version": "1.6.6",
  "description": "Validation, field extraction and creation of IBAN, BBAN, BIC numbers",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/cjs/index.d.ts",
  "keywords": [
    "IBAN",
    "BBAN",
    "BIC",
    "validator",
    "iban-validator",
    "ISO 3136-1 alpha-2"
  ],
  "files": [
    "README.md",
    "LICENSE.txt",
    "lib",
    "src"
  ],
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src test && tsc --noEmit -p tsconfig-lint.json",
    "test": "vitest run",
    "build": "tsc",
    "prepublishOnly:esm": "tsc -p tsconfig.json",
    "prepublishOnly:cjs": "tsc -p tsconfig-cjs.json",
    "prepublishOnly": "npm run prepublishOnly:esm && npm run prepublishOnly:cjs",
    "lint:package": "publint --level error && attw --pack .",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koblas/ibankit-js.git"
  },
  "author": "David Koblas",
  "license": "ISC",
  "homepage": "https://github.com/koblas/ibankit-js",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
